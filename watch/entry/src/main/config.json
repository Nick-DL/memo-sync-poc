{
  "app": {
    "bundleName": "com.example.memo.hmw",
    "vendor": "memo-sync-poc",
    "version": {
      "code": 1,
      "name": "0.1.0"
    }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": "default",
        "icon": "$media:icon",
        "label": "$string:app_name",
        "type": "page"
      }
    ],
    "metaData": {
      "customizeData": [
        {
          "name": "supportLists",
          "value": "com.example.memo:<PHONE_APK_CERT_SHA256_PLACEHOLDER>"
        }
      ]
    },
    "distroFilter": {
      "screenShape": {
        "value": [
          "rect"
        ],
        "policy": "include"
      },
      "screenWindow": {
        "value": [
          "408*480"
        ],
        "policy": "include"
      }
    },
    "js": [
      {
        "name": "default",
        "pages": [
          "pages/list/list",
          "pages/detail/detail",
          "pages/edit/edit",
          "pages/keyboard_rect/keyboard"
        ]
      }
    ]
  }
}
